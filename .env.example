# ai-orchestrator — environment contract (AD-20). Every variable of both components lives here.
# Copy to .env; docker compose reads it. `make lint` fails when a settings field is missing from this file.

# ── Access (AD-4) ────────────────────────────────────────────────────────────
ORCHESTRATOR_TOKEN=change-me-long-random            # the one credential: web login + API bearer
ORCHESTRATOR_SESSION_SECRET=change-me-32-bytes      # web-client cookie signing
ORCHESTRATOR_SECRET_KEY=change-me-fernet-key        # backend-api: Fernet key for Project env vars (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")

# ── Components ───────────────────────────────────────────────────────────────
# BACKEND_API_URL is the compose service name, which is what web-client resolves from inside
# the network; the two ports below are published on 127.0.0.1 only by docker-compose.yml.
BACKEND_API_URL=http://backend-api:8000              # web-client → backend-api (server side only)
WEB_CLIENT_PORT=4321
BACKEND_API_PORT=8000
LOG_LEVEL=info
LOG_PROMPT_CONTENT_DEFAULT=false                     # FR-2 per-Project default

# ── Database (app schema `public` + DBOS schema `dbos`, same database) ───────
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orchestrator                             # image postgres:18
DATABASE_URL=postgresql+psycopg://orchestrator:change-me@postgres:5432/orchestrator
DBOS_APPLICATION_VERSION=1                           # pinned; bump only when the walker's step sequence changes (AD-6)
MAX_ACTIVE_RUNS=2                                    # global queue concurrency; a parked (needs_you) Run holds a slot (AD-12)

# ── Git (AD-5) — read by git commands only, never by a harness ───────────────
GITHUB_TOKEN=ghp_change-me

# ── Gateway: LiteLLM on the host ─────────────────────────────────────────────
LITELLM_BASE_URL=http://host.docker.internal:4000
LITELLM_API_KEY=sk-change-me                         # virtual key generated with key_type: llm_api (model routes only); the only Gateway key a harness ever receives (AD-5)
LITELLM_SPEND_KEY=sk-change-me-admin                 # master or proxy_admin_viewer key; reads /spend/logs/v2 for budget and cost (AD-11); backend-api only, never in a harness env
LOCAL_MODELS=local-coder,local-general               # LiteLLM aliases exposed to the `local` harness (OpenCode)

# ── Tracing: Langfuse on the host (AD-11) ────────────────────────────────────
LANGFUSE_BASE_URL=http://host.docker.internal:3000
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
LANGFUSE_ENVIRONMENT=mvp
# Host-side LiteLLM (not read by the containers, documented in host/README.md): LITELLM_OTEL_V2=true + callbacks: [langfuse_otel]

# ── Harness image ────────────────────────────────────────────────────────────
# Read by scripts/harness/<name>.sh at image build (install) and at container start
# (configure). The host halves these talk to are set up in host/README.md.
BMAD_VERSION=6.11.0                                  # must equal _bmad/_config/manifest.yaml in every target repo (AD-16)
CLAUDE_CODE_VERSION=2.1.258
CODEX_VERSION=0.152.1
OPENCODE_VERSION=1.18.26
LANGFUSE_OPENCODE_PLUGIN_VERSION=0.3.0
AGENT_HOME=/home/agent                               # HOME of the non-root user; ~/.claude ~/.codex ~/.config/opencode live here (volume agent-home)
WORK_DIR=/work                                       # base clones, worktrees, logs (volume work)
CLAUDE_ALLOWED_TOOLS='Task,Bash(uv run *),Bash(git *),Bash(pnpm *),Bash(npm *),Bash(make *),Edit,Read,Write,Skill,ToolSearch'   # quoted: the parentheses make this unsourceable otherwise (PRD §8 Q1, resolved day 3)
