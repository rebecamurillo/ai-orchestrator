# ai-orchestrator — environment contract (AD-20). Every variable of both components lives here.
# Copy to .env; docker compose reads it. `make lint` fails when a settings field is missing from this file.
#
# The contract is two-tier (Operator decision 2026-09-20, two-tier configuration contract;
# reaffirmed 2026-09-30). REQUIRED below is what the stack refuses to start without — six
# lines, all of them secrets or the URL that carries one. Everything under OPTIONAL has a
# code default equal to the value printed here, so a `.env` may leave any of those lines out,
# or leave one blank, and the app boots on the default. This file stays the full documented
# reference either way: `make lint` checks it against the typed settings module in both
# directions, and a test compares every default against the value shown here.

# ══ REQUIRED ═════════════════════════════════════════════════════════════════

# ── Access (AD-4) ────────────────────────────────────────────────────────────
ORCHESTRATOR_TOKEN=change-me-long-random            # the one credential: web login + API bearer
ORCHESTRATOR_SESSION_SECRET=change-me-32-bytes      # web-client cookie signing
ORCHESTRATOR_SECRET_KEY=change-me-fernet-key        # backend-api: Fernet key for Project env vars. THIS PLACEHOLDER IS NOT A VALID KEY — until you replace it every write to /api/v1/projects answers 500. Mint one: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# ── Database credential (app schema `public` + DBOS schema `dbos`, same database) ──
# The password appears twice on purpose: postgres is created with it, and DATABASE_URL is
# how backend-api connects. They are two spellings of one fact — change them in one edit.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://orchestrator:change-me@postgres:5432/orchestrator

# ── Git (AD-5) — read by git commands only, never by a harness ───────────────
GITHUB_TOKEN=ghp_change-me

# ══ OPTIONAL — the value shown is the code default; delete or blank any line ══

# ── Components ───────────────────────────────────────────────────────────────
# BACKEND_API_URL is the compose service name, which is what web-client resolves from inside
# the network; the two ports below are published on 127.0.0.1 only by docker-compose.yml.
BACKEND_API_URL=http://backend-api:8000              # web-client → backend-api (server side only)
WEB_CLIENT_PORT=4321
BACKEND_API_PORT=8000
LOG_LEVEL=info
LOG_PROMPT_CONTENT_DEFAULT=false                     # FR-2 per-Project default
# Which Templates /workflows/new offers, in this order. A name nothing stores is dropped.
# Leave it BLANK to offer every stored Template a Run can start from instead — everything
# except the ones declaring a required `item` input, which are only ever called by another
# Template. Read by web-client only; a change needs a restart.
ROOT_TEMPLATES=initiative-hub,repo-init
# Test mode (SPEC CAP-1). `1` registers the scripted `fake` harness and seeds its row
# enabled, so the dev loop can be driven end to end without a model; it changes nothing
# else. Leave it `0` on any instance an Operator uses — `fake` is offered nowhere while
# it is off, because its `harness` row does not exist and pre-flight refuses the name.
ORCH_TEST_MODE=0                                     # test-only; `make e2e` sets it to 1

# ── Database (the rest) ──────────────────────────────────────────────────────
POSTGRES_USER=orchestrator
POSTGRES_DB=orchestrator                             # image postgres:18
DBOS_APPLICATION_VERSION=1                           # pinned; bump only when the walker's step sequence changes (AD-6)
MAX_ACTIVE_RUNS=2                                    # global queue concurrency; a parked (needs_you) Run holds a slot (AD-12); for a multi-repo initiative set at least the number of member repos + 1
HUMAN_WAIT_SECONDS=2592000                           # how long a parked Run waits for you before it fails `parked 30 days` (AD-13)
WORKTREE_RETENTION_DAYS=7                            # a terminal Run's worktrees and logs are kept this long before `worktree_gc` sweeps them (SPEC CAP-11)
CLONE_CHECK_CRON='0 3 * * *'                         # `clone_check`'s own schedule: daily (SPEC CAP-11, FR-4). Quoted: the spaces and `*` make this unsourceable otherwise
WORKTREE_GC_CRON='30 3 * * *'                        # `worktree_gc`'s own schedule: daily (SPEC CAP-11, FR-9)
TERMINAL_POLL_CRON='*/30 * * * * *'                  # `terminal_poll`'s own schedule: every 30 s (SPEC CAP-7, FR-21). Six fields, because the period is seconds
READINESS_BUDGET_USD=5                               # harness_readiness.start's own budget_usd (SPEC CAP-8)
# harness_readiness.start's own model, one per harness (SPEC CAP-8): a readiness Run proves plumbing
# on a trivial story, so each is the cheapest route on that harness that can finish it. Every model
# named here must be a model_name the Gateway serves (deploy/llm-platform/litellm.config.yaml); every harness the
# image installs must have a pair, or backend-api refuses to start rather than binding no model.
READINESS_MODELS=claude=claude-sonnet-4-6,codex=gpt-5.4,local=local-coder
# Which stored Template each of the two built-in actions dispatches (AD-7, AD-15). Names, never
# name@version: the latest stored version of the name is resolved at dispatch, so storing a second
# version of either is picked up without a restart. The shipped files are exemplars — point these
# at your own copies and nothing in the product cares.
INIT_TEMPLATE=repo-init                              # the Repository row's *Initialise repository* action
READINESS_TEMPLATE=epic                              # harness_readiness.start's own template (SPEC CAP-8)

# ── Gateway: LiteLLM on the host ─────────────────────────────────────────────
# Off by default: the shipped default for the base URL is blank, and blank is the off switch
# (gateway off, spend provisional, the `local` harness unavailable). The line below is the
# working example — uncomment-and-fill is what turns the integration on, and a non-blank base
# URL with a blank LITELLM_API_KEY is refused at start-up rather than at first use.
LITELLM_BASE_URL=http://host.docker.internal:4000  # blank to disable (gateway off, spend provisional); local harness needs the Gateway
LITELLM_API_KEY=sk-change-me                         # virtual key generated with key_type: llm_api (model routes only); the only Gateway key a harness ever receives (AD-5)
LITELLM_SPEND_KEY=sk-change-me-admin                 # master or proxy_admin_viewer key; reads /spend/logs/v2 for budget and cost (AD-11); backend-api only, never in a harness env
LOCAL_MODELS=local-coder,local-general               # LiteLLM aliases exposed to the `local` harness (OpenCode)
LITELLM_SPEND_MATCH=session                          # how one attempt's spend rows are found: session (x-litellm-session-id, verified 5.3) | attempt_tag (fallback when a request path drops that header but keeps x-litellm-tags; 7.2's runbook measures it)

# ── Tracing: Langfuse on the host (AD-11) ────────────────────────────────────
# Off by default for the same reason and in the same way as the Gateway above.
LANGFUSE_BASE_URL=http://host.docker.internal:3000  # blank to disable (tracing off, traces absent, cost.trace_url null)
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
LANGFUSE_ENVIRONMENT=mvp
LANGFUSE_PROJECT_ID=change-me-langfuse-project-id                       # LangfuseTracer.trace_url formats the UI link from this alone (AD-11)
# Host-side LiteLLM (not read by the containers, documented in deploy/llm-platform/README.md): LITELLM_OTEL_V2=true + callbacks: [langfuse_otel]

# ── Notifications ────────────────────────────────────────────────────────────
# Off by default: blank NOTIFY_WEBHOOK_URL sends nothing. One POST per Run that reaches needs_you, done, failed or cancelled; delivery is best-effort and never fails the Run.
# NOTIFY_WEBHOOK_URL: blank to disable; the POST target for Run notifications
NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_SECRET: optional; when set, X-Orchestrator-Signature: sha256=<hex HMAC-SHA256 of the body>
NOTIFY_WEBHOOK_SECRET=
NOTIFY_WEBHOOK_FORMAT=json                           # json (structured event) | slack (Slack/Mattermost incoming-webhook {"text": ...})
# PUBLIC_BASE_URL: where the web client is reached from outside (e.g. https://orchestrator.example.com); blank omits the Run link
PUBLIC_BASE_URL=

# ── Harness image ────────────────────────────────────────────────────────────
# Read by scripts/harness/<name>.sh at image build (install) and at container start
# (configure). The host halves these talk to are set up in deploy/llm-platform/README.md. The four paths
# below default to the image's own layout, so a container needs none of them.
BMAD_VERSION=6.11.0                                  # must equal _bmad/_config/manifest.yaml in every target repo (AD-16)
CLAUDE_CODE_VERSION=2.1.258
CODEX_VERSION=0.152.1
OPENCODE_VERSION=1.18.26
LANGFUSE_OPENCODE_PLUGIN_VERSION=0.3.0
AGENT_HOME=/home/agent                               # HOME of the non-root user; ~/.claude ~/.codex ~/.config/opencode live here (volume agent-home)
WORK_DIR=/work                                       # base clones, worktrees, logs (volume work)
TEMPLATES_DIR=/app/templates                         # shipped Templates the backend reads (AD-15); ../templates in a local, non-image dev run
HARNESS_SCRIPTS_DIR=/app/scripts/harness             # probe() shells these scripts; ../scripts/harness in a local, non-image dev run
KIT_DIR=/app/deploy/kit                              # the client kit GET /api/v1/kit/* serves; ../deploy/kit in a local, non-image dev run
CLAUDE_ALLOWED_TOOLS=Task,Bash,Edit,Read,Write,Glob,Grep,Skill,ToolSearch   # `Bash` whole (D-1, 2026-10-12): the container is the sandbox, the adapter denies `git push`; a list of command families parks `blocked` on every one it forgot
CLAUDE_SUBSCRIPTION_AUTH=false                       # false: the Gateway virtual key goes to the harness as ANTHROPIC_AUTH_TOKEN (API-key mode).
                                                     # true: Claude Code is logged in on the operator's own Claude subscription, so that OAuth token
                                                     # holds Authorization, the virtual key moves to the x-litellm-api-key header, and
                                                     # ANTHROPIC_AUTH_TOKEN is not set at all. Needs forward_client_headers_to_llm_api on the
                                                     # Gateway — host-side, see deploy/llm-platform/README.md. Never an Anthropic API key either way (AD-5).
