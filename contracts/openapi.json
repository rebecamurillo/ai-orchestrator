            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ProjectUpdate",
        "type": "object"
      },
      "RepositoryCreate": {
        "description": "`POST /projects/{project_id}/repositories`.",
