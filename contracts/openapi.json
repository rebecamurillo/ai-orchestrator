      "ProjectRead": {
        "description": "A Project as every read returns it, its Repositories embedded.\n\nEvery read answers the same shape (POST's 201, PUT's 200, both GETs) \u2014 a Repository\nadded between two reads is exactly the kind of state change the Operator relies on the\nnext read to show, and a narrower shape for the list or the create response would have\nto justify why *that* read is allowed to lie about what is stored.",
        "properties": {
          "context_paths": {
            "items": {
              "type": "string"
            },
            "title": "Context Paths",
            "type": "array"
          },
          "context_text": {
            "title": "Context Text",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "env_vars": {
            "items": {
              "$ref": "#/components/schemas/MaskedEnvVarOut"
            },
            "title": "Env Vars",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "log_prompt_content": {
            "title": "Log Prompt Content",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "repositories": {
            "items": {
              "$ref": "#/components/schemas/RepositoryOut"
            },
            "title": "Repositories",
            "type": "array"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "context_text",
          "context_paths",
          "env_vars",
          "log_prompt_content",
          "repositories",
          "created_at",
          "updated_at"
        ],
        "title": "ProjectRead",
        "type": "object"
      },
      "ProjectUpdate": {
