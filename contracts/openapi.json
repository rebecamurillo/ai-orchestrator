{
  "components": {
    "schemas": {
      "EnvVarCreate": {
        "description": "One requested variable on a create, where there is nothing to keep.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "name",
          "value"
        ],
        "title": "EnvVarCreate",
        "type": "object"
      },
      "EnvVarIn": {
        "description": "One requested variable. Without a `value`, the stored ciphertext is kept.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "name"
        ],
        "title": "EnvVarIn",
        "type": "object"
      },
      "Health": {
        "description": "The `/healthz` payload. Typed so the generated contract carries a real schema (AD-3).",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "Health",
        "type": "object"
      },
      "MaskedEnvVarOut": {
        "description": "One stored variable as it leaves this API: the name, and four characters of the value.",
        "properties": {
          "masked": {
            "title": "Masked",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "masked"
        ],
        "title": "MaskedEnvVarOut",
        "type": "object"
      },
      "Page_ProjectRead_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProjectRead"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "Page[ProjectRead]",
        "type": "object"
      },
      "Pong": {
        "description": "The `/api/v1/ping` payload. Typed so the generated contract carries a schema (AD-3).",
        "properties": {
          "pong": {
            "title": "Pong",
            "type": "boolean"
          }
        },
        "required": [
          "pong"
        ],
        "title": "Pong",
        "type": "object"
      },
      "ProblemDetail": {
        "description": "The problem document itself. Members that do not apply are omitted, never `null`.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ProblemError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "ProblemDetail",
        "type": "object"
      },
      "ProblemError": {
        "description": "One entry of `errors[]`.\n\n`reason` is always present; the rest name where the reason applies \u2014 a request field\n(`path`) or a place in a workflow template (`template`, `version`, `line`).",
        "properties": {
          "line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "template": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Template"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "reason"
        ],
        "title": "ProblemError",
        "type": "object"
      },
      "ProjectCreate": {
        "description": "`POST /projects`. Every variable carries its value.",
        "properties": {
          "context_paths": {
            "items": {
              "type": "string"
            },
            "title": "Context Paths",
            "type": "array"
          },
          "context_text": {
            "default": "",
            "title": "Context Text",
            "type": "string"
          },
          "env_vars": {
            "items": {
              "$ref": "#/components/schemas/EnvVarCreate"
            },
            "title": "Env Vars",
            "type": "array"
          },
          "log_prompt_content": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Log Prompt Content"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ProjectCreate",
        "type": "object"
      },
      "ProjectRead": {
        "description": "A Project as every read returns it. There is no field here that could hold a value.",
        "properties": {
          "context_paths": {
            "items": {
              "type": "string"
            },
            "title": "Context Paths",
            "type": "array"
          },
          "context_text": {
            "title": "Context Text",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "env_vars": {
            "items": {
              "$ref": "#/components/schemas/MaskedEnvVarOut"
            },
            "title": "Env Vars",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "log_prompt_content": {
            "title": "Log Prompt Content",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "context_text",
          "context_paths",
          "env_vars",
          "log_prompt_content",
          "created_at",
          "updated_at"
        ],
        "title": "ProjectRead",
        "type": "object"
      },
      "ProjectUpdate": {
        "description": "`PUT /projects/{id}`. A variable without a value keeps the one already stored.",
        "properties": {
          "context_paths": {
            "items": {
              "type": "string"
            },
            "title": "Context Paths",
            "type": "array"
          },
          "context_text": {
            "default": "",
            "title": "Context Text",
            "type": "string"
          },
          "env_vars": {
            "items": {
              "$ref": "#/components/schemas/EnvVarIn"
            },
            "title": "Env Vars",
            "type": "array"
          },
          "log_prompt_content": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Log Prompt Content"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ProjectUpdate",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "The instance ORCHESTRATOR_TOKEN.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "ai-orchestrator backend-api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/ping": {
      "get": {
        "operationId": "ping_api_v1_ping_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pong"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The request carried no valid ORCHESTRATOR_TOKEN."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Confirm the bearer token is accepted",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/projects": {
      "get": {
        "description": "Every Project, ordered by name, each with its variables masked.\n\nOne page: the whole list is small enough that a cursor would be ceremony. The envelope\nis the same one every list in this API uses, so paging can arrive without a break.",
        "operationId": "list_projects_api_v1_projects_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_ProjectRead_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The request carried no valid ORCHESTRATOR_TOKEN."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List every Project",
        "tags": [
          "projects"
        ]
      },
      "post": {
        "description": "Store a Project. Every variable value is encrypted before it is written (AD-5).",
        "operationId": "create_project_api_v1_projects_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The request carried no valid ORCHESTRATOR_TOKEN."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Another Project already holds that name."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The request broke a rule; `errors[]` names it and the reason."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create a Project",
        "tags": [
          "projects"
        ]
      }
    },
    "/api/v1/projects/{project_id}": {
      "get": {
        "description": "One Project, with every variable masked. An unknown id is a 404 problem document.",
        "operationId": "get_project_api_v1_projects__project_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Project Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The request carried no valid ORCHESTRATOR_TOKEN."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "No Project has that id."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The request broke a rule; `errors[]` names it and the reason."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read one Project",
        "tags": [
          "projects"
        ]
      },
      "put": {
        "description": "Replace a Project's editable fields, and with them its whole variable set.\n\nA variable sent without a value keeps the ciphertext already stored, which is how a\nform that was never given the secret can send the set back without losing it. An\nomitted `log_prompt_content` keeps the stored switch for the same reason; no instance\ndefault is read here, so this route takes no settings.",
        "operationId": "update_project_api_v1_projects__project_id__put",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Project Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The request carried no valid ORCHESTRATOR_TOKEN."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "No Project has that id."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Another Project already holds that name."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The request broke a rule; `errors[]` names it and the reason."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Update a Project",
        "tags": [
          "projects"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    }
  }
}
