# web-client — the Astro standalone server, the only origin the browser talks to (AD-1).
#
# Built from `web-client/` as its own context: the component needs nothing from the rest of
# the repository, because `src/api/schema.d.ts` is committed and generated by `make openapi`
# rather than at build time (AD-3).
#
# Four stages so the runtime image carries production dependencies only — Playwright, the
# linters and the type checker have no business in the image the Operator runs.

# syntax=docker/dockerfile:1

ARG NODE_IMAGE=node:24-bookworm-slim

FROM ${NODE_IMAGE} AS deps
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm build

FROM ${NODE_IMAGE} AS runtime-deps
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile --prod

FROM ${NODE_IMAGE}
# `astro.config.mjs` pins 127.0.0.1 for `astro dev` and the Playwright preview; inside the
# container the server is reached over the compose network, so the standalone entry binds
# every interface and the published port is the loopback one compose declares.
ENV NODE_ENV=production \
    HOST=0.0.0.0
WORKDIR /app

COPY --from=runtime-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/package.json ./package.json

USER node

# Informational: the published port comes from WEB_CLIENT_PORT in `.env`.
EXPOSE 4321

# The standalone entry reads PORT; the contract spells the same value WEB_CLIENT_PORT, and
# this is the one place the two names meet.
CMD ["sh", "-c", "PORT=\"${WEB_CLIENT_PORT:-4321}\" exec node ./dist/server/entry.mjs"]
