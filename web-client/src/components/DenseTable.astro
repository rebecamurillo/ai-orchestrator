---
/**
 * Where the record grid does not apply. A dense table has as many columns as the data has —
 * the Steps table, the queue readout, the Runs history — and it carries the same hairlines
 * and the same column heads as everything else, so it reads as the same instrument.
 *
 * Cells are strings: this component aligns and rules, it does not format. A status belongs
 * in a `StatusToken` the caller renders into the cell, never in a colour applied here.
 */
interface Props {
  columns: string[];
  rows: string[][];
  testId?: string;
}

const { columns, rows, testId } = Astro.props;
---

<table class="dense" data-testid={testId}>
  <thead>
    <tr>{columns.map((column) => <th scope="col">{column}</th>)}</tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          {row.map((cell) => (
            <td>{cell}</td>
          ))}
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .dense th {
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-rail);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-text-tertiary);
    font-size: var(--type-column-head);
    letter-spacing: var(--type-column-head-tracking);
    text-transform: var(--type-column-head-transform);
    text-align: left;
  }

  .dense td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-text-secondary);
    font-size: var(--type-row-body);
    line-height: var(--type-row-body-line);
  }
</style>
