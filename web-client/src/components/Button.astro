---
/**
 * Outline only: transparent ground, hairline border, uppercase control label. There is no
 * filled button anywhere in this product — a filled rectangle is an area of colour, and
 * colour is signal. Primary is distinguished by the accent border and label, destructive by
 * the failed signal, and both are a border, never a fill.
 *
 * Rendered as an `<a>` when it navigates and a `<button>` when it acts, so the keyboard and
 * the screen reader are told which of the two it is.
 */
interface Props {
  label: string;
  href?: string;
  variant?: 'default' | 'primary' | 'destructive';
  testId?: string;
}

const { label, href, variant = 'default', testId } = Astro.props;
---

{
  href ? (
    <a class="button" data-variant={variant} data-testid={testId} href={href}>
      {label}
    </a>
  ) : (
    <button class="button" data-variant={variant} data-testid={testId} type="button">
      {label}
    </button>
  )
}

<style>
  .button {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--color-line-strong);
    background: none;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--type-control);
    letter-spacing: var(--type-control-tracking);
    text-transform: var(--type-control-transform);
    text-decoration: none;
  }

  .button:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  .button[data-variant='primary'] {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .button[data-variant='destructive'] {
    border-color: var(--color-signal-failed);
    color: var(--color-signal-failed);
  }
</style>
