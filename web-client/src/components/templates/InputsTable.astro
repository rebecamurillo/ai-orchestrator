---
/**
 * INPUTS BOUND AT START (3.5, UX-DR15): every entry of a Template's `inputs:` map, read
 * straight off `TemplateVersionOut.inputs` — no derivation, since the API already shapes
 * each entry as `{name, type, required, default}` for exactly this table.
 */
import type { components } from '../../api/schema';

type InputDecl = components['schemas']['InputDeclOut'];

interface Props {
  inputs: InputDecl[];
}

const { inputs } = Astro.props;

function defaultText(value: InputDecl['default']): string {
  if (value === null || value === undefined) return '—';
  if (typeof value === 'boolean') return value ? 'true' : 'false';
  return String(value);
}
---

<section data-testid="templates-inputs">
  {
    inputs.length === 0 ? (
      <p class="empty">no inputs declared</p>
    ) : (
      <table class="inputs">
        <thead>
          <tr>
            <th scope="col">input</th>
            <th scope="col">type</th>
            <th scope="col">required</th>
            <th scope="col">default</th>
          </tr>
        </thead>
        <tbody>
          {inputs.map((input) => (
            <tr>
              <td>{input.name}</td>
              <td>{input.type}</td>
              <td>{input.required ? 'yes' : 'no'}</td>
              <td>{defaultText(input.default)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</section>

<style>
  .empty {
    padding: var(--space-6);
    color: var(--color-text-secondary);
    font-size: var(--type-row-body);
    line-height: var(--type-row-body-line);
  }

  .inputs th {
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-rail);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-text-tertiary);
    font-size: var(--type-column-head);
    letter-spacing: var(--type-column-head-tracking);
    text-transform: var(--type-column-head-transform);
    text-align: left;
  }

  .inputs td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-text-secondary);
    font-size: var(--type-row-body);
    line-height: var(--type-row-body-line);
  }
</style>
