---
/**
 * One row of the Project list (2.4). Not `RecordRow`: that grid has five fixed columns for a
 * run-shaped record (type · project · repository · what · age) and none of them fit a
 * Project, whose row states its own repository count and failed count instead. The
 * one-link-target and hover conventions are the same as `RecordRow`'s.
 *
 * At most one coloured count per row (NFR-6): `needsYouCount` amber takes priority over
 * `failedCount` red; both absent means no colour element at all.
 */
interface Props {
  id: string;
  slug: string;
  name: string;
  repositoryCount: number;
  failedCount: number;
  needsYouCount?: number;
  selected: boolean;
  href: string;
}

const { slug, name, repositoryCount, failedCount, needsYouCount = 0, selected, href } = Astro.props;
---

<a class="row" data-testid={`projects-row-${slug}`} data-selected={String(selected)} href={href}>
  <span class="name">{name}</span>
  <span class="meta">
    {repositoryCount} repositories · 0 runs{
      needsYouCount > 0 ? (
        <span class="needs-you"> · {needsYouCount} need you</span>
      ) : (
        failedCount > 0 && <span class="failed"> · {failedCount} failed</span>
      )
    }
  </span>
</a>

<style>
  .row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
  }

  .row:hover {
    background: var(--color-surface-raised);
    text-decoration: none;
  }

  .row[data-selected='true'] {
    background: var(--color-surface-raised);
  }

  .name {
    color: var(--color-text);
    font-size: var(--type-row-title);
    line-height: var(--type-row-title-line);
  }

  .meta {
    color: var(--color-text-tertiary);
    font-size: var(--type-meta);
    line-height: var(--type-meta-line);
  }

  .failed {
    color: var(--color-signal-failed);
  }

  .needs-you {
    color: var(--color-signal-needs-you);
  }
</style>
