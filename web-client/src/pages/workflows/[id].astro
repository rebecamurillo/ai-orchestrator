---
/**
 * Run detail (4.15, SPEC CAP-15, FR-23, story 1-4): header, alert banner, stop zone, embedded
 * diagram, summary column, and tabbed gate/steps/session region. RunDetail always mounts here.
 *
 * The route takes no `view` parameter (EXPERIENCE-v1 §2.2, 2026-09-24). `?view=diagram` was a
 * surface of its own until 2026-09-15 and a 301 back to here until the v3 diagram rework;
 * the redirect is deleted with the toggle that pointed at it, so an old bookmark now serves
 * the run detail directly, with the diagram embedded in it, and no extra round trip.
 *
 * No server-side read of its own — RunDetail does its own polled fetch client:load.
 */
import Shell from '../../layouts/Shell.astro';
import RunDetail from '../../islands/RunDetail';

export const prerender = false;

const { id } = Astro.params;
---

<Shell active="workflows" title="RUN DETAIL">
  <RunDetail client:load runId={id as string} />
</Shell>
