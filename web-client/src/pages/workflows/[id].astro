---
/**
 * Run detail (4.15, SPEC CAP-15, FR-23, story 1-4): header, alert banner, stop zone, embedded
 * diagram, summary column, and tabbed gate/steps/session region. RunDetail always mounts here.
 *
 * `?view=diagram` redirects 301 to `/workflows/{id}` — the diagram is now embedded inside
 * RunDetail's layout via DiagramSection. RunDiagram is no longer mounted from this page.
 *
 * No server-side read of its own — RunDetail does its own polled fetch client:load.
 */
import Shell from '../../layouts/Shell.astro';
import RunDetail from '../../islands/RunDetail';

export const prerender = false;

const { id } = Astro.params;

if (Astro.url.searchParams.get('view') === 'diagram') {
  return Astro.redirect(`/workflows/${id}`, 301);
}
---

<Shell active="workflows" title="RUN DETAIL">
  <RunDetail client:load runId={id as string} />
</Shell>
