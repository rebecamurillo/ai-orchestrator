---
/**
 * New workflow (4.13, SPEC CAP-13, UX-DR8): the form that binds a Template's inputs, beside
 * the pre-flight readout and the plan the Run will execute.
 *
 * Three reads build the page — `GET /templates`, `GET /projects`, `GET /harnesses` — exactly
 * the brief's own list, issued together and each best effort so a slow or failing read
 * narrows the page rather than crashing it.
 *
 * The Template list comes from `ROOT_TEMPLATES` where an Operator set one. Left blank it
 * names none, and the offer is then every *stored* Template a Run can start from — the ones
 * declaring no input a caller has to bind (`catalog.ts::rootStartable`), in the order
 * `GET /templates` returns them. No list of Template names lives in this repository's code
 * either way (Operator decision 2026-09-30: no template name hardcoded in product code).
 *
 * Each offered name needs a `latest_version` resolved here — without one *Start run* can
 * build no `POST /runs` body — and the Template's own declared `inputs`, which are what the
 * form asks for and what the derived offer is filtered on. The list read answers neither
 * reliably (the shared e2e stub answers `GET /api/v1/templates` unconditionally empty, and a
 * real instance's list is paginated), so a name `ROOT_TEMPLATES` asks for that the list did
 * not carry is resolved through `GET /templates/{name}/versions`, and every surviving one
 * through `GET /templates/{name}/{version}`. A name that resolves to neither is dropped.
 *
 * A `?project=` naming a Project the (equally forced-empty, equally paginated) list read did
 * not carry is resolved the same way, through `GET /projects/{project_id}` — the route
 * `projects/[id].astro` already reads.
 *
 * The empty state distinguishes "nothing is stored" from "backend-api could not be read":
 * the first is a fact about the instance, the second is a fact about this request, and
 * saying the first when the second happened would state something untrue (NFR-8). A bare
 * visit against a reachable backend with nothing stored still renders `NO TEMPLATE TO BIND`,
 * which is what the frozen `shell.spec.ts` asserts.
 */
import { ROOT_TEMPLATES } from 'astro:env/server';
import EmptyState from '../../components/EmptyState.astro';
import Shell from '../../layouts/Shell.astro';
import { backend } from '../../api/server';
import NewWorkflow from '../../islands/NewWorkflow';
import { buildCatalog, parseRootTemplates, rootStartable } from '../../lib/newwf/catalog';
import { parseFormStateFromQuery } from '../../lib/newwf/query';
import { reconcileInitial } from '../../lib/newwf/state';
import type { components } from '../../api/schema';

export const prerender = false;

type TemplateSummary = components['schemas']['TemplateSummaryOut'];
type ProjectRead = components['schemas']['ProjectRead'];
type HarnessOut = components['schemas']['HarnessOut'];
type InputDeclOut = components['schemas']['InputDeclOut'];

const namedTemplates = parseRootTemplates(ROOT_TEMPLATES);
const namesAreConfigured = namedTemplates.length > 0;

const projectParam = Astro.url.searchParams.get('project');

/** Every read here is best effort, and each one reports whether it actually answered: a
 * failure must not be rendered as an empty list (see the module doc). */
async function read<T>(load: () => Promise<T | null>): Promise<{ data: T | null; ok: boolean }> {
  try {
    const data = await load();
    return { data, ok: data !== null };
  } catch {
    return { data: null, ok: false };
  }
}

const [templateList, projectList, harnessList] = await Promise.all([
  read<TemplateSummary[]>(async () => {
    const { data, error } = await backend().GET('/api/v1/templates');
    return error || !data ? null : data.items;
  }),
  read<ProjectRead[]>(async () => {
    const { data, error } = await backend().GET('/api/v1/projects');
    return error || !data ? null : data.items;
  }),
  read<HarnessOut[]>(async () => {
    const { data, error } = await backend().GET('/api/v1/harnesses');
    return error || !data ? null : data.items;
  }),
]);

let templates: TemplateSummary[] = templateList.data ?? [];
let projects: ProjectRead[] = projectList.data ?? [];
const harnesses: HarnessOut[] = harnessList.data ?? [];

/**
 * The offered Templates the list read did not carry, so the dropdown never offers a name
 * whose version *Start run* cannot pin. Only attempted once there is reason to believe this
 * instance has Templates — the list carried one, or a link named one — so a bare visit to an
 * empty instance still renders the "nothing is stored" readout `shell.spec.ts` measures.
 */
const namedByLink = Astro.url.searchParams.has('template') || projectParam !== null;
const unresolved =
  namesAreConfigured && (templates.length > 0 || namedByLink)
    ? namedTemplates.filter((name) => !templates.some((template) => template.name === name))
    : [];

const resolved = await Promise.all(
  unresolved.map(async (name) => {
    const { data } = await read<number[]>(async () => {
      const { data, error } = await backend().GET('/api/v1/templates/{name}/versions', {
        params: { path: { name } },
      });
      return error || !data || data.items.length === 0 ? null : data.items;
    });
    if (!data) return null;
    return {
      name,
      description: null,
      latest_version: Math.max(...data),
      versions: data,
    } satisfies TemplateSummary;
  }),
);
templates = [...templates, ...resolved.filter((entry) => entry !== null)];

/** The names to resolve inputs for: the configured list, or every stored name. */
const rootTemplates = namesAreConfigured ? namedTemplates : templates.map((t) => t.name);

/**
 * What each offered Template asks for. `TemplateSummaryOut` carries no `inputs`, so the
 * declarations come from the version read — one call per offered name, issued together.
 *
 * Failures are counted, not only dropped: "this instance does not store it" and "the read did
 * not answer" are two different sentences to put on screen (NFR-8).
 */
let detailsUnread = 0;
const details = await Promise.all(
  rootTemplates.map(async (name) => {
    const version = templates.find((template) => template.name === name)?.latest_version;
    if (version === undefined || version === null) return null;
    const { data, ok } = await read<InputDeclOut[]>(async () => {
      const { data, error } = await backend().GET('/api/v1/templates/{name}/{version}', {
        params: { path: { name, version } },
      });
      return error || !data ? null : data.inputs;
    });
    if (!ok || data === null) {
      detailsUnread += 1;
      return null;
    }
    return [name, data] as const;
  }),
);
const inputsByName = Object.fromEntries(details.filter((entry) => entry !== null));
/** Without a configured list, a Template is offered only if a Run can start from it: one
 * declaring a required `item` input is called by another Template and has no form of its own
 * (FR-33). With a list, the Operator named it and it is offered as named. */
const offeredTemplates = namesAreConfigured
  ? rootTemplates
  : rootTemplates.filter(
      (name) => Object.hasOwn(inputsByName, name) && rootStartable(inputsByName[name]!),
    );
const catalog = buildCatalog(offeredTemplates, inputsByName);

if (projectParam && !projects.some((project) => project.id === projectParam)) {
  const { data } = await read<ProjectRead>(async () => {
    const { data, error } = await backend().GET('/api/v1/projects/{project_id}', {
      params: { path: { project_id: projectParam } },
    });
    return error || !data ? null : data;
  });
  if (data) projects = [...projects, data];
}

//: the catalog, not the list read: a stored Template `ROOT_TEMPLATES` does not name is one
//: there is no form to bind
const hasTemplates = catalog.names.length > 0;
//: nothing answered — every statement about what is stored would be a guess
const unreachable =
  (!templateList.ok && templates.length === 0) || (!hasTemplates && detailsUnread > 0);
const initial = reconcileInitial(
  parseFormStateFromQuery(Astro.url.searchParams, catalog),
  projects,
  harnesses,
  catalog,
);
---

<Shell active="workflows" title="NEW WORKFLOW">
  {
    unreachable ? (
      <EmptyState
        testId="newwf-unavailable"
        headline="TEMPLATES UNAVAILABLE"
        lines={[
          'The template list could not be read from backend-api, so there are no inputs to bind.',
          'Reload the page once the connection is restored.',
        ]}
      />
    ) : !hasTemplates ? (
      <EmptyState
        testId="newwf-empty"
        headline="NO TEMPLATE TO BIND"
        lines={[
          'No stored template can be started from, so there are no inputs to bind and no plan to show.',
          'Templates are listed on /templates; a run is started from one of them.',
        ]}
      />
    ) : (
      <NewWorkflow
        client:load
        templates={templates}
        catalog={catalog}
        projects={projects}
        harnesses={harnesses}
        initial={initial}
      />
    )
  }
</Shell>
