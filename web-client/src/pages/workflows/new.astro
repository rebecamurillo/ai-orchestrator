---
/**
 * New workflow — the form that binds a template's inputs, beside the pre-flight readout and
 * the plan the run will execute. The form is template-dependent, so with no template stored
 * there are no input rows to render.
 */
import EmptyState from '../../components/EmptyState.astro';
import Shell from '../../layouts/Shell.astro';

export const prerender = false;
---

<Shell active="workflows" title="NEW WORKFLOW">
  <EmptyState
    testId="newwf-empty"
    headline="NO TEMPLATE TO BIND"
    lines={[
      'No template version is stored, so there are no inputs to bind and no plan to show.',
      'Templates are listed on /templates; a run is started from one of them.',
    ]}
  />
</Shell>
