---
/**
 * New workflow (4.13, SPEC CAP-13, UX-DR8): the form that binds a Template's inputs, beside
 * the pre-flight readout and the plan the Run will execute. The form is Template-dependent,
 * so with no Template known there is nothing to bind and no plan to show.
 *
 * Three reads build the page — `GET /templates`, `GET /projects`, `GET /harnesses` — exactly
 * the brief's own list, each best effort so a slow or failing read narrows the page rather
 * than crashing it.
 *
 * A "start a new run" link (the brief's own `?template=&project=&repository=&branch=`
 * prefill) may name a Template or a Project the bare lists above do not carry — most often
 * because whatever is deep-linked is not near the front of either list. When that happens
 * this page resolves the one entity by name or id (`GET /templates/{name}/versions`,
 * `GET /projects/{project_id}` — the same routes `templates/[name]/[version].astro` and
 * `projects/[id].astro` already read) and folds it into what is rendered, so a real link
 * still opens a working form. A bare visit carries none of these parameters, so none of this
 * runs, and the bare lists decide alone — which is what keeps the frozen `shell.spec.ts`'s
 * "NO TEMPLATE TO BIND" reading of `/workflows/new` true unchanged: the shared e2e stub
 * answers both bare lists empty (their own Design Notes), exactly as before this story.
 */
import EmptyState from '../../components/EmptyState.astro';
import Shell from '../../layouts/Shell.astro';
import { backend } from '../../api/server';
import NewWorkflow from '../../islands/NewWorkflow';
import { parseFormStateFromQuery } from '../../lib/newwf/query';
import { isTemplateName } from '../../lib/newwf/state';
import type { components } from '../../api/schema';

export const prerender = false;

type TemplateSummary = components['schemas']['TemplateSummaryOut'];
type ProjectRead = components['schemas']['ProjectRead'];
type HarnessOut = components['schemas']['HarnessOut'];

const templateParam = Astro.url.searchParams.get('template');
const projectParam = Astro.url.searchParams.get('project');

let templates: TemplateSummary[] = [];
try {
  const { data, error } = await backend().GET('/api/v1/templates');
  if (!error && data) templates = data.items;
} catch {
  // best effort — see the module doc
}

let projects: ProjectRead[] = [];
try {
  const { data, error } = await backend().GET('/api/v1/projects');
  if (!error && data) projects = data.items;
} catch {
  // best effort — see the module doc
}

let harnesses: HarnessOut[] = [];
try {
  const { data, error } = await backend().GET('/api/v1/harnesses');
  if (!error && data) harnesses = data.items;
} catch {
  // best effort — see the module doc
}

if (
  templateParam &&
  isTemplateName(templateParam) &&
  !templates.some((template) => template.name === templateParam)
) {
  try {
    const { data, error } = await backend().GET('/api/v1/templates/{name}/versions', {
      params: { path: { name: templateParam } },
    });
    if (!error && data && data.items.length > 0) {
      templates = [
        ...templates,
        {
          name: templateParam,
          description: null,
          latest_version: Math.max(...data.items),
          versions: data.items,
        },
      ];
    }
  } catch {
    // best effort — see the module doc
  }
}

if (projectParam && !projects.some((project) => project.id === projectParam)) {
  try {
    const { data, error } = await backend().GET('/api/v1/projects/{project_id}', {
      params: { path: { project_id: projectParam } },
    });
    if (!error && data) projects = [...projects, data];
  } catch {
    // best effort — see the module doc
  }
}

const hasTemplates = templates.length > 0;
const initial = parseFormStateFromQuery(Astro.url.searchParams);
---

<Shell active="workflows" title="NEW WORKFLOW">
  {
    !hasTemplates ? (
      <EmptyState
        testId="newwf-empty"
        headline="NO TEMPLATE TO BIND"
        lines={[
          'No template version is stored, so there are no inputs to bind and no plan to show.',
          'Templates are listed on /templates; a run is started from one of them.',
        ]}
      />
    ) : (
      <NewWorkflow
        client:load
        templates={templates}
        projects={projects}
        harnesses={harnesses}
        initial={initial}
      />
    )
  }
</Shell>
