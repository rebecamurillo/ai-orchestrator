---
/**
 * Initiative detail (S7, `GET /initiatives/{slug}`): the cross-repository DAG on one screen.
 *
 * No server-side read of its own — `InitiativeDetail` does its own polled fetch client:load,
 * `RunDetail`'s own precedent (`workflows/[id].astro`'s module doc).
 */
import Shell from '../../../layouts/Shell.astro';
import InitiativeDetail from '../../../islands/InitiativeDetail';

export const prerender = false;

const { slug } = Astro.params;
---

<Shell active="workflows" title="INITIATIVE">
  <InitiativeDetail client:load slug={slug as string} />
</Shell>
