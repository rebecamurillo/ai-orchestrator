---
/**
 * Workflows — the home surface. The board of runs by status arrives with the read models in
 * epic 4; until a project exists there is nothing to run, so the readout says so and names
 * the two surfaces that change it.
 */
import EmptyState from '../components/EmptyState.astro';
import Shell from '../layouts/Shell.astro';

export const prerender = false;
---

<Shell active="workflows" title="WORKFLOWS" count="0 runs">
  <EmptyState
    testId="board-empty"
    headline="NOTHING REGISTERED"
    lines={[
      'No project is registered, so no run can be started.',
      'A project binds the repositories a run works in; register one on /projects.',
      'A run is then started from a template on /workflows/new.',
    ]}
  />
</Shell>
