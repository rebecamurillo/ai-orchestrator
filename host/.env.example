# The host stack's own contract — LiteLLM and Langfuse, run from `host/docker-compose.yml`.
#
# This file is NOT the orchestrator's contract. The repository root `.env.example` is (AD-20),
# and `make lint` checks that one against the typed settings module. These two files meet in
# exactly four places, listed under "Where the two contracts meet" at the bottom.
#
# Never fill this file in. Run `make host-up`; it calls `host/generate-env.sh`, which writes
# `host/.env` with freshly generated secrets. `host/.env` is git-ignored and never committed.

# ── Postgres (this stack's own, not the orchestrator's) ───────────────────────
# Published on 5433 because the orchestrator's postgres already holds 5432.
HOST_POSTGRES_USER=langfuse
HOST_POSTGRES_PASSWORD=                              # generated: openssl rand -hex 24
HOST_POSTGRES_PORT=5433

# ── ClickHouse — Langfuse's analytics store ───────────────────────────────────
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=                                 # generated: openssl rand -hex 24

# ── MinIO — S3-compatible storage for Langfuse's event and media uploads ──────
# The API port is published because Langfuse hands the browser presigned URLs against it.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=                                 # generated: openssl rand -hex 24
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9091

# ── Langfuse ─────────────────────────────────────────────────────────────────
LANGFUSE_PORT=3000
NEXTAUTH_SECRET=                                     # generated: openssl rand -base64 32
LANGFUSE_SALT=                                       # generated: openssl rand -base64 32
LANGFUSE_ENCRYPTION_KEY=                             # generated: openssl rand -hex 32 (exactly 64 hex chars)

# The first sign-in, created on start so nothing has to be clicked through a UI.
LANGFUSE_INIT_USER_EMAIL=operator@example.com
LANGFUSE_INIT_USER_NAME=Operator
LANGFUSE_INIT_USER_PASSWORD=                         # generated: openssl rand -hex 12
LANGFUSE_INIT_ORG_NAME=OptimAI
LANGFUSE_INIT_PROJECT_NAME=ai-orchestrator

# ── LiteLLM ──────────────────────────────────────────────────────────────────
LITELLM_PORT=4000
LITELLM_MASTER_KEY=                                  # generated: "sk-" + openssl rand -hex 24

# Upstream providers. Real inference needs at least one of these to be a real key; the proxy
# starts, answers /health and lists /v1/models without them, which is all the harness
# `doctor` check requires.
ANTHROPIC_API_KEY=not-set
OPENAI_API_KEY=not-set

# oMLX runs on the host, so a container reaches it through the gateway rather than localhost.
OMLX_BASE_URL=http://host.docker.internal:8000/v1
OMLX_API_KEY=not-set

# Google Vertex AI — the Gemini routes. Authentication is a service-account JSON key rather
# than an API key, so this is its PATH ON THIS MACHINE, bind-mounted read-only into the proxy
# at /app/vertex-sa.json. Blank disables those two routes and nothing else.
VERTEX_PROJECT=not-set
VERTEX_CREDENTIALS_FILE=                             # absolute path to the service-account JSON; blank disables the Gemini routes

# OpenRouter — one key for many upstream providers; `litellm.config.yaml` routes
# `openrouter-qwen3-coder-480b` through it. Left `not-set` that route answers 401 and the
# rest of the proxy is unaffected, the same posture as the two keys above.
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=not-set

# ── Where the two contracts meet ─────────────────────────────────────────────
# `host/generate-env.sh` writes these four values into BOTH files, so the orchestrator's
# containers can reach this stack without anything being copied by hand:
#
#   root .env                      host/.env
#   LITELLM_BASE_URL          →    LITELLM_PORT
#   LITELLM_API_KEY           →    minted from LITELLM_MASTER_KEY after the proxy is up
#   LANGFUSE_BASE_URL         →    LANGFUSE_PORT
#   LANGFUSE_PUBLIC_KEY       ←    LANGFUSE_INIT_PROJECT_PUBLIC_KEY
#   LANGFUSE_SECRET_KEY       ←    LANGFUSE_INIT_PROJECT_SECRET_KEY
#
# The two project keys are generated here and echoed into the root `.env` by
# `make host-env-sync`, which is the only thing that writes to the root `.env`.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=                    # generated: "pk-lf-" + uuid
LANGFUSE_INIT_PROJECT_SECRET_KEY=                    # generated: "sk-lf-" + uuid
