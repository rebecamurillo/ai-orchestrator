# ── BMad Method (v6.11.0) ───────────────────────────────────────
# Committed: _bmad/{config.toml,custom/config.toml,_config,core,bmm,scripts}
# and _bmad-output/ — so every worktree is BMad-ready with no setup.
# _bmad/render/ and _bmad/custom/*.user.toml self-ignore via their own
# .gitignore files; the two rules below are the ones BMad does not ship.
_bmad/config.user.toml
.claude/skills/bmad-*
# macOS
.DS_Store

# ── Environment (AD-20) ─────────────────────────────────────────
# .env.example is the committed contract; a filled .env never is.
.env
.env.*
!.env.example

# ── Python (backend-api) ────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/

# ── Node (web-client) ───────────────────────────────────────────
node_modules/
.astro/
dist/
.pnpm-store/
