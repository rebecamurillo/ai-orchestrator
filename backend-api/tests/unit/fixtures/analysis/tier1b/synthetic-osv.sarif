{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "osv-scanner",
          "version": "2.7.1",
          "informationUri": "https://github.com/google/osv-scanner",
          "rules": [
            {
              "id": "GHSA-xxxx-xxxx-xxxx",
              "shortDescription": { "text": "GHSA-xxxx-xxxx-xxxx: synthetic advisory" },
              "helpUri": "https://osv.dev/GHSA-xxxx-xxxx-xxxx"
            }
          ]
        }
      },
      "artifacts": [{ "location": { "uri": "package-lock.json" }, "length": -1 }],
      "results": [
        {
          "ruleId": "GHSA-xxxx-xxxx-xxxx",
          "level": "warning",
          "message": {
            "text": "Package 'left-pad@1.3.0' is vulnerable to 'GHSA-xxxx-xxxx-xxxx'."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "package-lock.json" },
                "region": { "startLine": 1 }
              }
            }
          ]
        }
      ]
    }
  ]
}
